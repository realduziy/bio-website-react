# Port the application server runs on (Default: 3000)
PORT=3000

# Administrative credentials for the Admin panel
# You can set these directly as plain text (e.g. ADMIN_USERNAME_HASH=admin)
# OR as a SHA-256 hash (e.g., using `echo -n "myPassword" | sha256sum` or any online SHA256 generator)
ADMIN_USERNAME_HASH=admin
ADMIN_PASSWORD_HASH=change_this_password

# Discord ID and client details for Spotify & presence status tracking
DEFAULT_DISCORD_ID=1025531959736860714
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Last.fm username for 24/7 background scrobble & top tracks sync (optional)
LASTFM_USERNAME=
